import cv2
import numpy as np
import matplotlib.pyplot as plt
from skimage.exposure import match_histograms
def generate_reference(shape, mean=128, std=50, seed=42):
    """Synthetic reference image with a target Gaussian intensity distribution."""
    rng = np.random.default_rng(seed)
    ref = rng.normal(loc=mean, scale=std, size=shape)
    ref = np.clip(ref, 0, 255).astype(np.uint8)
    return ref
img1 = cv2.imread('D:\Picture1.png', cv2.IMREAD_GRAYSCALE)
# ---- Histogram Equalization ----
hist_eq_img1 = cv2.equalizeHist(img1)
# ---- Histogram Matching ----
reference1 = generate_reference(img1.shape, mean=150, std=40)
hist_match_img1 = match_histograms(img1, reference1, channel_axis=None).astype(np.uint8)
plt.figure(figsize=(15, 5))
plt.subplot(1, 3, 1)
plt.title("Original (1.png)")
plt.imshow(img1, cmap='gray'); plt.axis('off')
plt.subplot(1, 3, 2)
plt.title("Histogram Equalization")
plt.imshow(hist_eq_img1, cmap='gray'); plt.axis('off')
plt.subplot(1, 3, 3)
plt.title("Histogram Matching (target μ=150, σ=40)")
plt.imshow(hist_match_img1, cmap='gray'); plt.axis('off') 
plt.tight_layout()
plt.show()
