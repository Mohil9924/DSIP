import cv2
import numpy as np

def create_motion_psf(length=15, angle=45):
    """Generates a Point Spread Function (PSF) for motion blur reconstruction."""
    psf = np.zeros((length, length), dtype=np.float32)
    psf[int((length - 1) / 2), :] = 1.0
    M = cv2.getRotationMatrix2D((length / 2 - 0.5, length / 2 - 0.5), angle, 1.0)
    psf = cv2.warpAffine(psf, M, (length, length))
    return psf / np.sum(psf)

def wiener_deconvolution(img, psf, K=0.01):
    """Applies Wiener Deconvolution in the frequency domain."""
    img_fft = np.fft.fft2(img.astype(np.float32))
    psf_fft = np.fft.fft2(psf, s=img.shape)
    
    psf_fft_conj = np.conj(psf_fft)
    wiener_filter = psf_fft_conj / (np.abs(psf_fft)**2 + K)
    
    restored_fft = img_fft * wiener_filter
    restored = np.fft.ifft2(restored_fft)
    
    return np.clip(np.abs(restored), 0, 255).astype(np.uint8)

# Load motion-blurred image in grayscale
img_path = r"D:\Picture5.png"
img5 = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)

if img5 is None:
    print("Error: Could not load image. Check the file path.")
else:
    # Step 1: Create Motion Blur PSF (adjust length and angle if needed)
    psf = create_motion_psf(length=20, angle=45)

    # Step 2: Apply Wiener Deconvolution
    deblurred_5 = wiener_deconvolution(img5, psf, K=0.005)

    # Step 3: Post-Restoration Unsharp Masking for Edge Sharpness
    gaussian_blur = cv2.GaussianBlur(deblurred_5, (3, 3), 1.0)
    enhanced_5 = cv2.addWeighted(deblurred_5, 1.3, gaussian_blur, -0.3, 0)

    # Save Output
    cv2.imwrite(r"D:\enhanced_Picture5.png", enhanced_5)
    print("Image 5 enhanced and saved successfully as 'D:\\enhanced_Picture5.png'!")
