import cv2
import numpy as np

# Load image using raw string path
img_path = r"D:\Picture1.png"
img1 = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)

if img1 is None:
    print("Error: Could not load image. Check the file path.")
else:
    # Step 1: Remove salt-and-pepper noise using Median Blur
    smoothed_1 = cv2.medianBlur(img1, ksize=3)

    # Step 2: Edge sharpening via Unsharp Masking
    gaussian_blur = cv2.GaussianBlur(smoothed_1, (5, 5), 1.0)
    enhanced_1 = cv2.addWeighted(smoothed_1, 1.5, gaussian_blur, -0.5, 0)

    # Save output
    cv2.imwrite(r"D:\enhanced_Picture1.png", enhanced_1)
    print("Image processed and saved successfully!")
