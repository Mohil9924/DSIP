import cv2
import numpy as np

def enhance_periodic_noise_image(input_path, output_path):
    # Load image in grayscale
    img = cv2.imread(input_path, cv2.IMREAD_GRAYSCALE)
    
    if img is None:
        print(f"Error: Could not load image from {input_path}")
        return

    # Step 1: Compute 2D Fast Fourier Transform (FFT)
    f = np.fft.fft2(img)
    fshift = np.fft.fftshift(f)
    
    # Step 2: Create a Notch Reject Filter Mask to eliminate periodic interference
    rows, cols = img.shape
    crow, ccol = rows // 2, cols // 2
    mask = np.ones((rows, cols), np.float32)
    
    # Define circular notch centers targeting the periodic interference spikes in frequency domain
    # You can adjust notch radii (r) if needed depending on stripe density
    r = 6
    notch_centers = [
        (crow - 35, ccol - 35), (crow + 35, ccol + 35),
        (crow - 70, ccol - 70), (crow + 70, ccol + 70),
        (crow - 35, ccol + 35), (crow + 35, ccol - 35),
        (crow - 70, ccol + 35), (crow + 70, ccol - 35)
    ]
    
    y, x = np.ogrid[:rows, :cols]
    for cy, cx in notch_centers:
        dist_from_center = np.sqrt((x - cx)**2 + (y - cy)**2)
        mask[dist_from_center <= r] = 0.0

    # Step 3: Apply filter mask and Inverse FFT
    fshift_filtered = fshift * mask
    f_ishift = np.fft.ifftshift(fshift_filtered)
    img_back = np.fft.ifft2(f_ishift)
    img_back = np.abs(img_back)
    
    # Normalize image to standard uint8 range [0, 255]
    img_filtered = cv2.normalize(img_back, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)

    # Step 4: Edge Sharpening using Unsharp Masking
    gaussian_blur = cv2.GaussianBlur(img_filtered, (5, 5), 1.0)
    enhanced = cv2.addWeighted(img_filtered, 1.4, gaussian_blur, -0.4, 0)

    # Save output
    cv2.imwrite(output_path, enhanced)
    print(f"Successfully enhanced and saved: {output_path}")

